from typing import List
from .database import db
from .models import Product
from rapidfuzz import fuzz, process
import math
import re

class SearchService:
    @staticmethod
    def search(query: str, limit: int = 20) -> List[Product]:
        query = query.lower().strip()
        all_products = db.get_all_products()
        
        if not query:
            return all_products[:limit]
            
        # Intent Analysis
        is_sasta = "sasta" in query or "cheap" in query or "low price" in query
        is_premium = "premium" in query or "expensive" in query
        
        # Clean query for matching (remove intent words)
        clean_query = query.replace("sasta", "").replace("cheap", "").replace("wala", "").strip()
        if not clean_query:
             clean_query = "phone" 
             
        # Extract potential price constraints (e.g. "under 50k", "50000")
        price_limit = None
        price_match = re.search(r'under\s*(\d+)k?', query) or re.search(r'(\d+)k', query)
        if price_match:
            try:
                val = price_match.group(1)
                price_limit = int(val) * 1000 if 'k' in query or len(val) < 3 else int(val)
                clean_query = re.sub(r'under\s*\d+k?', '', clean_query).strip()
            except:
                pass

        scored_products = []
        
        for p in all_products:
            # 1. Text Relevance (Fuzzy)
            # WRatio handles lower/upper, partials, and some edit distance
            # Boost title weight
            title_score = fuzz.WRatio(clean_query, p.title)
            desc_score = fuzz.token_set_ratio(clean_query, p.description)
            
            relevance_score = (title_score * 0.7) + (desc_score * 0.3)
            
            # Threshold for relevance
            if relevance_score < 40: 
                continue

            # 2. Business Ranking
            # Boost by Rating (0-5) -> Scale to 0-50
            rating_boost = p.rating * 10 
            
            # Boost by Sales (Log scale) -> Scale 0-50 approx
            sales_boost = math.log(p.sales_count + 1) * 5
            
            # Stock availability (Binary boost)
            stock_boost = 20 if p.stock > 0 else 0
            
            final_score = relevance_score + rating_boost + sales_boost + stock_boost
            
            # 3. Intent Adjustments
            if is_sasta:
                # Invert price effect: Cheaper is better. 
                # Max price approx 150000. 
                price_score = (150000 - p.price) / 1000
                final_score += price_score
            elif is_premium:
                price_score = p.price / 1000
                final_score += price_score
                
            if price_limit and p.price > price_limit:
                final_score -= 1000 # Heavy penalty but don't exclude fully if very relevant
                
            scored_products.append((p, final_score))
            
        # Sort by score descending
        scored_products.sort(key=lambda x: x[1], reverse=True)
        
        return [p for p, score in scored_products[:limit]]

